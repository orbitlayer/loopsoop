# ---------------------------------------------------------------------------
# LOOPSOOP — Supabase (public, safe to expose in the browser bundle)
# Copy this file to .env.local and fill in the two values from
# Supabase Dashboard → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# NOTE: The service_role key is NEVER used by this app. Keep it secret in your
# Supabase dashboard only. All privileged setup (admin role grant, seeding) is
# done by you in the Supabase SQL Editor, not by app code.
